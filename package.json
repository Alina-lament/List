{
  "name": "younglife",
  "productName": "YoungLife",
  "version": "1.0.0",
  "private": true,
  "description": "清单 + 日历桌面应用",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "node scripts/with-clean-env.mjs electron-vite dev",
    "build": "electron-vite build",
    "preview": "node scripts/with-clean-env.mjs electron-vite preview",
    "test": "npm rebuild better-sqlite3 && vitest run",
    "test:watch": "npm rebuild better-sqlite3 && vitest",
    "rebuild:electron": "node scripts/rebuild-electron.mjs",
    "postinstall": "node scripts/rebuild-electron.mjs",
    "dist": "npm run build && electron-builder",
    "dist:dir": "npm run build && electron-builder --dir"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^8.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@headlessui/react": "^2.2.0",
    "@tanstack/react-virtual": "^3.11.2",
    "better-sqlite3": "^12.4.1",
    "dayjs": "^1.11.13",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "rrule": "^2.8.1",
    "vditor": "^3.11.2",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.20",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^35.1.5",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.7.2",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
